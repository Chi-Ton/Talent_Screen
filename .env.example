APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=talentscreen
POSTGRES_USER=talentscreen_app
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql+psycopg://talentscreen_app:change_this_local_password@127.0.0.1:5432/talentscreen

JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

FRONTEND_ORIGIN=http://localhost:3000
TZ=Asia/Bangkok

# Optional server-side AI provider. Never expose AI_API_KEY to the frontend.
AI_PROVIDER=disabled
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=
AI_MODEL=ag/gemini-3.8-flash-high
AI_TIMEOUT_SECONDS=90
AI_RETRY_COUNT=1
AI_PROMPT_VERSION=v3-private-document
AI_MAX_RESUME_CHARS=30000
AI_PRIVACY_MODE=redacted_remote
AI_STORE_EXTRACTED_TEXT=false
CV_RETENTION_DAYS=30
